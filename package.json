{
  "name": "turnip-ledger",
  "private": true,
  "version": "1.0.0",
  "description": "Fan-made Animal Crossing: New Leaf turnip calculator",
  "author": "Turnip Ledger",
  "desktopName": "turnip-ledger.desktop",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43123 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.turnipledger.app",
    "productName": "Turnip Ledger",
    "executableName": "turnip-ledger",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "icon": "public/turnip-icon.png",
      "category": "Utility",
      "synopsis": "New Leaf turnip calculator",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/turnip-icon.png"
    }
  }
}
